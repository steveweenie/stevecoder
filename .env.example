# ---------------------------------------------------------------
# stevecoder.com environment. Copy to .env.local for local dev.
# ---------------------------------------------------------------

# "mock" serves the design's mock data for every live widget, presence,
# guestbook, and contact (no external calls). Leave unset in production.
FEEDS_MODE=mock

# GitHub widget (GraphQL contributions + latest pushed commit).
# Fine-grained token, public read-only is enough.
GITHUB_TOKEN=
GITHUB_USERNAME=steveweenie

# Now Playing (Last.fm, fed by Apple Music scrobbles).
LASTFM_API_KEY=
LASTFM_USERNAME=

# Guitar Gatekeeper (YouTube Data API v3). Handle is used when no channel id is set.
YOUTUBE_API_KEY=
YOUTUBE_HANDLE=guitargatekeeper
YOUTUBE_CHANNEL_ID=

# Steam Web API. STEAM_ID is your 64-bit id; profile must be public.
STEAM_API_KEY=
STEAM_ID=

# Weather uses Open-Meteo: no key needed.

# Contact form (Resend). FROM must be on a domain verified in Resend.
RESEND_API_KEY=
CONTACT_TO_EMAIL=stevetheprogramminglover@gmail.com
CONTACT_FROM_EMAIL="stevecoder.com <contact@stevecoder.com>"

# Guestbook and rate limits: Upstash Redis via the Vercel Marketplace.
# The Marketplace integration sets KV_REST_API_URL / KV_REST_API_TOKEN automatically.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Players online + live cursors (Liveblocks). Secret key from the Liveblocks dashboard; both are off without it.
LIVEBLOCKS_SECRET_KEY=

# Bearer token for /api/guestbook/moderate (approve / reject pending entries).
GUESTBOOK_ADMIN_TOKEN=
